@model HR_PayRoll_Management.ViewModels.LoginViewModel
@{
    var settings = HR_PayRoll_Management.Helpers.SettingsHelper.GetSettings();
    ViewBag.Title = "Login - " + settings.CompanyName;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="@Url.Content(settings.LogoPath)" />
    <title>@ViewBag.Title</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --brand-dark: #072a34;
            --brand-primary: #1f527d;
            --brand-secondary: #1a466a;
            --brand-accent: #00A3E0;
            --brand-accent-subtle: #e6f6fc;
            --surface-bg: #F8FAFB;
            --card-border: #E3EBEF;
            --text-main: #142831;
            --text-muted: #647B87;
        }

        * {
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--surface-bg);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            margin: 0;
        }

        .auth-card {
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(10, 66, 82, 0.05), 0 1px 3px rgba(10, 66, 82, 0.03);
            max-width: 440px;
            width: 100%;
            padding: 2.75rem 2.25rem;
        }

        .logo-frame {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

            .logo-frame img {
                max-height: 72px;
                max-width: 100%;
                object-fit: contain;
            }

        .auth-heading {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--brand-dark);
            letter-spacing: -0.02em;
            margin-bottom: 0.35rem;
        }

        .auth-subheading {
            font-size: 0.875rem;
            color: var(--text-muted);
            line-height: 1.45;
            margin-bottom: 2rem;
        }

        .field-group {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .field-label {
            display: block;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--brand-primary);
            margin-bottom: 0.4rem;
        }

        .input-control-wrapper {
            position: relative;
        }

            .input-control-wrapper i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 0.95rem;
                transition: color 0.2s ease;
            }

        .auth-input {
            width: 100%;
            padding: 0.72rem 1rem 0.72rem 2.75rem;
            font-size: 0.9375rem;
            border: 1.5px solid var(--card-border);
            border-radius: 8px;
            background-color: #ffffff;
            color: var(--text-main);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            outline: none;
        }

            .auth-input:focus {
                border-color: var(--brand-accent);
                box-shadow: 0 0 0 3px rgba(0, 163, 224, 0.15);
            }

                .auth-input:focus + i {
                    color: var(--brand-accent);
                }

        .form-check-input:checked {
            background-color: var(--brand-accent);
            border-color: var(--brand-accent);
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(0, 163, 224, 0.2);
            border-color: var(--brand-accent);
        }

        .btn-submit {
            background-color: var(--brand-primary);
            color: #ffffff;
            font-size: 0.9375rem;
            font-weight: 600;
            border: 1px solid var(--brand-primary);
            border-radius: 8px;
            padding: 0.78rem 1rem;
            width: 100%;
            transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
            cursor: pointer;
        }

            .btn-submit:hover {
                background-color: var(--brand-secondary);
                border-color: var(--brand-secondary);
                color: #ffffff;
            }

            .btn-submit:active {
                transform: scale(0.99);
            }

        .btn-link-action {
            color: var(--brand-secondary);
            font-size: 0.8125rem;
            font-weight: 500;
            text-decoration: none;
        }

            .btn-link-action:hover {
                color: var(--brand-accent);
                text-decoration: underline;
            }

        .alert-error {
            background-color: #FFF2F2;
            border: 1px solid #FFD1D1;
            color: #B42318;
            border-radius: 8px;
            font-size: 0.84rem;
            padding: 0.75rem 1rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <main class="auth-card">
        <!-- Logo Section -->
        <div class="logo-frame">
            <img src="@Url.Content(settings.LogoPath)"
                 alt="@settings.CompanyName Logo"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <h3 class="fw-bold text-dark m-0" style="display: none; color: var(--brand-primary);">@settings.CompanyName</h3>
        </div>

        <div class="text-center">
            <h1 class="auth-heading">Sign In</h1>
            <p class="auth-subheading">Access the HR & Payroll portal for @settings.CompanyName</p>
        </div>

        @using (Html.BeginForm("Login", "Auth", new { ReturnUrl = Request.QueryString["ReturnUrl"] }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (ViewData.ModelState.Any(m => m.Value.Errors.Any()))
            {
                <div class="alert-error d-flex align-items-center">
                    <i class="fa-solid fa-circle-exclamation me-2 fs-6"></i>
                    <div>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0 list-unstyled" })
                    </div>
                </div>
            }

            <div class="field-group">
                <label for="Username" class="field-label">Username</label>
                <div class="input-control-wrapper">
                    @Html.TextBoxFor(m => m.Username, new
                    {
                        @class = "auth-input",
                        placeholder = "Enter your username",
                        autocomplete = "username",
                        required = "required"
                    })
                    <i class="fa-regular fa-user"></i>
                </div>
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <div class="field-group mb-3">
                <label for="Password" class="field-label">Password</label>
                <div class="input-control-wrapper">
                    @Html.PasswordFor(m => m.Password, new
                    {
                        @class = "auth-input",
                        placeholder = "Enter your password",
                        autocomplete = "current-password",
                        required = "required"
                    })
                    <i class="fa-solid fa-lock"></i>
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check m-0">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label text-muted" for="rememberMe" style="font-size: 0.8125rem;">
                        Remember this session
                    </label>
                </div>
                <a href="#" class="btn-link-action">Forgot password?</a>
            </div>

            <button type="submit" class="btn-submit">
                Sign In <i class="fa-solid fa-arrow-right ms-2 fs-6"></i>
            </button>
        }

        <footer class="text-center mt-4 pt-3 border-top" style="border-color: var(--card-border) !important;">
            <p class="text-muted mb-0" style="font-size: 0.775rem;">
                &copy; @DateTime.Now.Year @settings.CompanyName. All rights reserved.
            </p>
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


