@model HR_PayRoll_Management.ViewModels.AttendanceVM.AttendanceCreateViewModel

@{
    ViewBag.Title = "Create Attendance";
}


@section styles {
    <link href="~/Content/Attendance.css" rel="stylesheet" />
}


<div class="page-header">

    <div>
        <h1>Create Attendance</h1>
        <p>Add daily attendance record for an employee.</p>
    </div>


    <a href="@Url.Action("Index","Attendance",
        new { employeeId = Model.EmployeeId })"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-2"></i>
        Back

    </a>

</div>



<div class="card attendance-form-card">

    <div class="card-header">

        <i class="fa-solid fa-calendar-check me-2"></i>
        Attendance Information

    </div>



    <div class="card-body">


        @using (Html.BeginForm("Create",
            "Attendance",
            FormMethod.Post))
        {

            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(
                        x => x.EmployeeId,
                        new { @class = "form-label" }
                    )


                    @Html.DropDownListFor(
                        x => x.EmployeeId,
                        ViewBag.Employees as IEnumerable<SelectListItem>,
                        "-- Select Employee --",
                        new { @class = "form-select" }
                    )


                    @Html.ValidationMessageFor(
                        x => x.EmployeeId,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>




                <div class="col-md-6 mb-3">
                    @Html.LabelFor(
                        x => x.AttendanceDate,
                        new { @class = "form-label" }
                    )


                    @Html.TextBoxFor(
                        x => x.AttendanceDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date"
                        }
                    )


                    @Html.ValidationMessageFor(
                        x => x.AttendanceDate,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


            </div>





            <div class="row">


                <div class="col-md-6 mb-3">
                    @Html.LabelFor(x => x.EntryTime,new { @class = "form-label" })

                    @Html.TextBoxFor(x => x.EntryTime,new{@class = "form-control",type = "time"})
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(x => x.ExitTime, new { @class = "form-label" })
                    @Html.TextBoxFor(x => x.ExitTime, new { @class = "form-control", type = "time" })
                </div>
            </div>





            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(x => x.Status,new { @class = "form-label" })

                    @Html.DropDownListFor(x => x.Status,
                        new List<SelectListItem>
                        {
                            new SelectListItem
                            {
                                Text="Present",
                                Value="Present"
                            },

                            new SelectListItem
                            {
                                Text="Absent",
                                Value="Absent"
                            },

                            new SelectListItem
                            {
                                Text="Leave",
                                Value="Leave"
                            }

                        },
                        "-- Select Status --",
                        new
                        {
                            @class = "form-select"
                        }
                    )


                </div>



                <div class="col-md-6 mb-3">
                    @Html.LabelFor(x => x.Remarks,new { @class = "form-label" })

                    @Html.TextBoxFor(x => x.Remarks, new
                    {
                            @class = "form-control",
                            placeholder = "Optional remarks"
                    })
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check me-2"></i>Save Attendance
                </button>

                <a href="@Url.Action("Index","Attendance", new { employeeId = Model.EmployeeId })" class="btn btn-light border">
                    Cancel
                </a>
            </div>
        }
    </div>
</div>