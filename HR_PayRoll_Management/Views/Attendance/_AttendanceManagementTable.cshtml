@model HR_PayRoll_Management.ViewModels.AttendanceVM.AttendaneManagementVM
@using System.Linq

@functions {
    public string FormatWorkingHours(double? hours)
    {
        if (!hours.HasValue) return "-";
        int totalMinutes = (int)(hours.Value * 60);
        int hour = totalMinutes / 60;
        int minute = totalMinutes % 60;
        return $"{hour}h {minute}m";
    }

    public string GetStatusBadgeClass(string status)
    {
        switch (status)
        {
            case "Present": return "bg-success";
            case "Absent": return "bg-danger";
            case "Leave": return "bg-warning text-dark";
            case "Half Day": return "bg-info";
            default: return "bg-secondary";
        }
    }
}

<table class="table table-hover attendance-table mb-0">
    <thead>
        <tr>
            <th>Date</th>
            <th>Employee</th>
            <th>Department</th>
            <th>Status</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Late</th>
            <th>Working Hours</th>
            <th class="text-end">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AttendanceRecords == null || !Model.AttendanceRecords.Any())
        {
            <tr>
                <td colspan="9" class="text-center py-5">
                    <i class="fa-solid fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    <p class="text-muted mb-0">No attendance records found for the selected filters.</p>
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model.AttendanceRecords)
            {
                <tr>
                    <td>
                        <span class="fw-semibold">@item.AttendanceDate.ToString("dd")</span>
                        <span class="text-muted">@item.AttendanceDate.ToString("MMM yyyy")</span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(item.PhotoPath))
                            {
                                <img src="@Url.Content(item.PhotoPath)" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 12px; font-weight: bold;">
                                    @(item.EmployeeName.Substring(0, 1).ToUpper())
                                </div>
                            }
                            <span class="fw-semibold">@item.EmployeeName</span>
                        </div>
                    </td>
                    <td>@item.DepartmentName</td>
                    <td>
                        <span class="badge @GetStatusBadgeClass(item.Status)">@item.Status</span>
                    </td>
                    <td>@(item.EntryTime.HasValue ? item.EntryTime.Value.ToString(@"hh\:mm") : "-")</td>
                    <td>@(item.ExitTime.HasValue ? item.ExitTime.Value.ToString(@"hh\:mm") : "-")</td>
                    <td>
                        @if (item.IsLate)
                        {
                            <span class="badge bg-danger"><i class="fa-solid fa-clock me-1"></i>Late</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>@FormatWorkingHours(item.WorkingHours)</td>
                    <td class="text-end">
                        <a href="@Url.Action("Edit", "Attendance", new { id = item.AttendanceId })" class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-attendance" data-id="@item.AttendanceId" title="Delete">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
