@model HR_PayRoll_Management.ViewModels.AttendanceVM.AttendaneManagementVM
@{
    ViewBag.Title = "Attendance Management";
}

@functions {
    public string FormatWorkingHours(double? hours)
    {
        if (!hours.HasValue) return "-";
        int totalMinutes = (int)(hours.Value * 60);
        int hour = totalMinutes / 60;
        int minute = totalMinutes % 60;
        return $"{hour}h {minute}m";
    }

    public string GetStatusBadgeClass(string status)
    {
        switch (status)
        {
            case "Present": return "bg-success";
            case "Absent": return "bg-danger";
            case "Leave": return "bg-warning text-dark";
            case "Half Day": return "bg-info";
            default: return "bg-secondary";
        }
    }
}

@section styles {
    <link href="~/Content/Attendance.css" rel="stylesheet" />
    <style>
        .filter-card { border: none; box-shadow: 0 2px 10px rgba(0,0,0,.08); border-radius: 12px; }
        .filter-card .card-body { padding: 1.5rem; }
        .stat-card { border-radius: 10px; padding: 1rem 1.25rem; color: #fff; transition: transform 0.2s; }
        .stat-card:hover { transform: translateY(-3px); }
        .stat-card h4 { font-size: 1.75rem; font-weight: 700; margin: 0; }
        .stat-card p { margin: 0; font-size: 0.85rem; opacity: 0.9; }
        .stat-present { background: linear-gradient(135deg, #28a745, #20c997); }
        .stat-absent { background: linear-gradient(135deg, #dc3545, #e74c3c); }
        .stat-leave { background: linear-gradient(135deg, #ffc107, #f39c12); }
        .stat-late { background: linear-gradient(135deg, #6f42c1, #8e44ad); }
        .stat-total { background: linear-gradient(135deg, #0d6efd, #0dcaf0); }
        .attendance-table th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6c757d; border-bottom: 2px solid #dee2e6; }
        .attendance-table td { vertical-align: middle; font-size: 0.9rem; }
        .emp-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; margin-right: 8px; }
        .emp-avatar-placeholder { width: 32px; height: 32px; border-radius: 50%; background: #6c757d; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; margin-right: 8px; }
        .loading-overlay { display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,.8); z-index: 10; align-items: center; justify-content: center; border-radius: 12px; }
        .loading-overlay.active { display: flex; }
        .results-wrapper { position: relative; min-height: 200px; }
    </style>
}

<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-clipboard-check me-2"></i>Attendance Management</h1>
        <p>View, filter and manage employee attendance records in real-time.</p>
    </div>
    <div>
        <a href="@Url.Action("Create", "Attendance")" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Add Attendance
        </a>
        <a href="@Url.Action("Report", "Attendance")" class="btn btn-outline-primary ms-2">
            <i class="fa-solid fa-chart-pie me-1"></i> Reports
        </a>
    </div>
</div>

<!-- ============================================ -->
<!-- FILTER CARD                                   -->
<!-- ============================================ -->
<div class="card filter-card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            @if (User.IsInRole("Manager") && !User.IsInRole("Admin") && !User.IsInRole("HR Manager"))
            {
                int mgrDeptId = 0;
                using (var db = new HR_PayRoll_Management.DAL.AppDbContext())
                {
                    var u = System.Linq.Queryable.FirstOrDefault(db.Users.Include("Employee"), x => x.Username == User.Identity.Name);
                    if (u != null && u.Employee != null) { mgrDeptId = u.Employee.DepartmentId; }
                }
                <input type="hidden" id="hiddenManagerDeptId" value="@mgrDeptId" />
            }
            <div class="col-md-3">
                <label class="form-label fw-semibold"><i class="fa-solid fa-calendar-alt me-1"></i>Month</label>
                <select id="filterMonth" class="form-select">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" @(DateTime.Now.Month == i ? "selected" : "")>
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold"><i class="fa-solid fa-calendar me-1"></i>Year</label>
                <select id="filterYear" class="form-select">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                    {
                        <option value="@y" @(DateTime.Now.Year == y ? "selected" : "")>@y</option>
                    }
                </select>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("HR Manager") || User.IsInRole("HR Officer")) {
            <div class="col-md-3">
                <label class="form-label fw-semibold"><i class="fa-solid fa-building me-1"></i>Department</label>
                <select id="filterDept" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Value">@dept.Text</option>
                    }
                </select>
            </div>
            }

            <div class="col-md-2">
                <label class="form-label fw-semibold"><i class="fa-solid fa-tag me-1"></i>Status</label>
                <select id="filterStatus" class="form-select">
                    <option value="">All Status</option>
                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>
                    <option value="Leave">Leave</option>
                    <option value="Half Day">Half Day</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="button" id="btnFilter" class="btn btn-primary w-100">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- SUMMARY STATS (AJAX Updated)                  -->
<!-- ============================================ -->
<div class="row g-3 mb-4" id="statsRow">
    <div class="col">
        <div class="stat-card stat-total">
            <p>Total Records</p>
            <h4 id="statTotal">@(Model.AttendanceRecords != null ? Model.AttendanceRecords.Count() : 0)</h4>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-present">
            <p>Present</p>
            <h4 id="statPresent">@(Model.AttendanceRecords != null ? Model.AttendanceRecords.Count(x => x.Status == "Present") : 0)</h4>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-absent">
            <p>Absent</p>
            <h4 id="statAbsent">@(Model.AttendanceRecords != null ? Model.AttendanceRecords.Count(x => x.Status == "Absent") : 0)</h4>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-leave">
            <p>On Leave</p>
            <h4 id="statLeave">@(Model.AttendanceRecords != null ? Model.AttendanceRecords.Count(x => x.Status == "Leave") : 0)</h4>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-late">
            <p>Late</p>
            <h4 id="statLate">@(Model.AttendanceRecords != null ? Model.AttendanceRecords.Count(x => x.IsLate) : 0)</h4>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- RESULTS TABLE (AJAX Updated)                  -->
<!-- ============================================ -->
<div class="card filter-card">
    <div class="card-body results-wrapper">
        <div class="loading-overlay" id="loadingOverlay">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Loading attendance data...</p>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0"><i class="fa-solid fa-table-list me-2"></i>Attendance Records</h5>
            <span class="badge bg-primary" id="recordCount">@(Model.AttendanceRecords != null ? Model.AttendanceRecords.Count() : 0) records</span>
        </div>

        <div class="table-responsive" id="attendanceTableWrapper">
            @Html.Partial("_AttendanceManagementTable", Model)
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteAttendanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this attendance record?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteAttendanceForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // ========================================
            // AJAX FILTER - Real-time without reload
            // ========================================
            function loadAttendance() {
                var month = $('#filterMonth').val();
                var year = $('#filterYear').val();
                var departmentId = $('#filterDept').val();
                if ($('#hiddenManagerDeptId').length > 0) { departmentId = $('#hiddenManagerDeptId').val(); }
                var status = $('#filterStatus').val();

                $('#loadingOverlay').addClass('active');

                $.ajax({
                    url: '@Url.Action("FilterManagement", "Attendance")',
                    type: 'GET',
                    data: {
                        month: month,
                        year: year,
                        departmentId: departmentId,
                        status: status
                    },
                    success: function (response) {
                        $('#attendanceTableWrapper').html(response.html);
                        $('#statTotal').text(response.total);
                        $('#statPresent').text(response.present);
                        $('#statAbsent').text(response.absent);
                        $('#statLeave').text(response.leave);
                        $('#statLate').text(response.late);
                        $('#recordCount').text(response.total + ' records');
                        $('#loadingOverlay').removeClass('active');
                    },
                    error: function () {
                        alert('Error loading attendance data.');
                        $('#loadingOverlay').removeClass('active');
                    }
                });
            }

            // Filter button click
            $('#btnFilter').click(function () {
                loadAttendance();
            });

            // Auto-filter on dropdown change
            $('#filterMonth, #filterYear, #filterDept, #filterStatus').change(function () {
                loadAttendance();
            });

            // Delete modal
            $(document).on('click', '.btn-delete-attendance', function () {
                var id = $(this).data('id');
                var url = '@Url.Action("DeleteConfirm", "Attendance")' + '?id=' + id;
                $('#deleteAttendanceForm').attr('action', url);
                $('#deleteAttendanceModal').modal('show');
            });
        });
    </script>
}




