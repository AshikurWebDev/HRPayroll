@model IEnumerable<HR_PayRoll_Management.ViewModels.DesignationVM.DesignationViewModel>

@{
    ViewBag.Title = "Designation Master";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Designation Master</h1>
        <p class="text-muted mb-0">Manage employee job positions and designations.</p>
    </div>

    <a href="@Url.Action("Create", "Designations")" class="btn btn-primary">
        <i class="fa-solid fa-plus me-2"></i> Add Designation
    </a>
</div>

<div class="card employee-list-card shadow-sm">
    <div class="card-header employee-toolbar d-flex justify-content-between align-items-center bg-white py-3">
        <div class="employee-search position-relative w-50">
            <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <input type="text"
                   id="designationSearch"
                   class="form-control ps-5"
                   placeholder="Search designation..." />
        </div>

        <div class="employee-count text-muted fw-semibold">
            <i class="fa-solid fa-briefcase me-2"></i>
            <span>@Model.Count() Designations</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table employee-table align-middle table-hover mb-0" id="designationTable">
            <thead class="table-light">
                <tr>
                    <th>Designation</th>
                    <th>Description</th>
                    <th>Employees</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="employee-profile-cell d-flex align-items-center">
                                <div class="employee-avatar employee-avatar-fallback rounded-circle d-flex align-items-center justify-content-center bg-light text-secondary me-3"
                                     style="width: 40px; height: 40px;">
                                    <i class="fa-solid fa-user-tie"></i>
                                </div>

                                <div class="employee-identity">
                                    <span class="employee-name fw-bold d-block text-dark">
                                        @item.DesignationName
                                    </span>
                                    <span class="employee-email text-muted small">
                                        Employee Position
                                    </span>
                                </div>
                            </div>
                        </td>

                        <td>
                            <span class="text-muted">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                            </span>
                        </td>
                        <td>
                            <span class="department-badge">
                                <i class="fa-solid fa-users me-1"></i>
                                @item.EmployeeCount
                            </span>
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="@Url.Action("Edit", "Designations", new { id = item.DesignationId })"
                                   class="btn btn-outline-primary"
                                   title="Edit designation">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger delete-action"
                                        title="Delete designation"
                                        data-id="@item.DesignationId"
                                        data-name="@item.DesignationName"
                                        data-count="@item.EmployeeCount"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal">

                                    <i class="fa-regular fa-trash-can"></i>

                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state text-center py-5">
            <div class="empty-state-icon fs-1 text-muted mb-3">
                <i class="fa-solid fa-briefcase"></i>
            </div>
            <h5>No Designations Found</h5>
            <p class="text-muted">Create designations before assigning them to employees.</p>
            <a href="@Url.Action("Create", "Designations")" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i> Add Designation
            </a>
        </div>
    }
</div>

<form id="deleteForm" method="post" action="@Url.Action("Delete", "Designations")">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id" />
</form>

@*Delete Confirmation Modal*@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <span id="modalIcon" class="me-2 text-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <span id="modalTitle">Confirm Delete</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Blocked -->
                <div id="blockedSection" class="d-none">
                    <div class="alert alert-danger border-0">
                        <h6 class="fw-bold">
                            <i class="fa-solid fa-circle-xmark me-2"></i>
                            Cannot Delete Designation
                        </h6>
                        <p class="mb-0">
                            Designation <strong id="blockedDesignationName"></strong> cannot be deleted because
                            <strong id="employeeCount"></strong> employee(s) are assigned.
                        </p>
                    </div>
                    <small class="text-muted">Reassign employees before deleting this designation.</small>
                </div>

                <!-- Allowed -->
                <div id="allowedSection">
                    <p class="mb-2">Are you sure you want to delete this designation?</p>
                    <div class="p-3 bg-light rounded border">
                        <strong id="allowedDesignationName"></strong>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                @using (Html.BeginForm("Delete", "Designations", FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="designationId" name="id" />

                    <button type="submit" id="confirmDeleteBtn" class="btn btn-danger">
                        <i class="fa-solid fa-trash me-2"></i> Delete
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
                $(document).ready(function () {
                    $("#designationSearch").on("keyup", function () {
                        var value = $(this).val().toLowerCase();

                        $("#designationTable tbody tr").filter(function () {
                            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                        });
                    });
                });

                //Delete or validate the delete button if any employee is present under this then it will not delete 
                $(".delete-action").click(function () {
                    var id = $(this).data("id");
                    var name = $(this).data("name");
                    var count = parseInt($(this).data("count"), 10) || 0;

                    $("#designationId").val(id);

                    if (count > 0) {
                        $("#blockedSection").removeClass("d-none");
                        $("#allowedSection").addClass("d-none");

                        $("#blockedDesignationName").text(name);
                        $("#employeeCount").text(count);

                        $("#modalTitle").text("Deletion Blocked");
                        $("#modalIcon").html('<i class="fa-solid fa-circle-xmark text-danger"></i>');

                        $("#confirmDeleteBtn").addClass("d-none");
                    } else {
                        $("#blockedSection").addClass("d-none");
                        $("#allowedSection").removeClass("d-none");

                        $("#allowedDesignationName").text(name);

                        $("#modalTitle").text("Confirm Delete");
                        $("#modalIcon").html('<i class="fa-solid fa-triangle-exclamation text-warning"></i>');

                        $("#confirmDeleteBtn").removeClass("d-none");
                    }
                });
    </script>
}