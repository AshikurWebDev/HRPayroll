@model HR_PayRoll_Management.Models.LeaveType

@{
    ViewBag.Title = "Edit Leave Type";
}

<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-pen me-2"></i> Edit Leave Type</h1>
        <p>Modify leave category details.</p>
    </div>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm()) 
        {
            @Html.AntiForgeryToken()
            
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.LeaveTypeId)

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "form-label fw-bold" })
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.AllowedDays, htmlAttributes: new { @class = "form-label fw-bold" })
                        @Html.EditorFor(model => model.AllowedDays, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AllowedDays, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.GenderSpecific, htmlAttributes: new { @class = "form-label fw-bold" })
                        <select name="GenderSpecific" class="form-select">
                            <option value="" @(string.IsNullOrEmpty(Model.GenderSpecific) ? "selected" : "")>Any</option>
                            <option value="Male" @(Model.GenderSpecific == "Male" ? "selected" : "")>Male Only</option>
                            <option value="Female" @(Model.GenderSpecific == "Female" ? "selected" : "")>Female Only</option>
                        </select>
                        @Html.ValidationMessageFor(model => model.GenderSpecific, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            @Html.CheckBoxFor(model => model.IsPaid, new { @class = "form-check-input", @id = "IsPaid" })
                            <label class="form-check-label fw-bold" for="IsPaid">Is Paid Leave</label>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input", @id = "IsActive" })
                            <label class="form-check-label fw-bold" for="IsActive">Is Active</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-save me-1"></i> Update Leave Type</button>
                </div>
            </div>
        }
    </div>
</div>
