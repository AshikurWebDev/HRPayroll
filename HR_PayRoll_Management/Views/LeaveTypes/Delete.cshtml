@model HR_PayRoll_Management.Models.LeaveType

@{
    ViewBag.Title = "Delete Leave Type";
}

<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-trash me-2 text-danger"></i> Delete Leave Type</h1>
        <p class="text-danger">Are you sure you want to delete this leave type?</p>
    </div>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="card border-danger">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9 fw-bold">@Model.Name</dd>

            <dt class="col-sm-3">Allowed Days</dt>
            <dd class="col-sm-9">@Model.AllowedDays days</dd>

            <dt class="col-sm-3">Is Paid</dt>
            <dd class="col-sm-9">@(Model.IsPaid ? "Yes" : "No")</dd>

            <dt class="col-sm-3">Gender Specific</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.GenderSpecific) ? "Any" : Model.GenderSpecific)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
        </dl>

        @using (Html.BeginForm()) {
            @Html.AntiForgeryToken()
            <div class="mt-4">
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i> Confirm Delete</button>
            </div>
        }
    </div>
</div>
