@model IEnumerable<HR_PayRoll_Management.Models.LeaveType>

@{
    ViewBag.Title = "Leave Types";
}

<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-list-check me-2"></i> Leave Types</h1>
        <p>Manage different types of leaves available for employees.</p>
    </div>
    <div>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Add New Leave Type
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Allowed Days</th>
                        <th>Paid</th>
                        <th>Gender Specific</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.AllowedDays</td>
                            <td>
                                @if (item.IsPaid) {
                                    <span class="badge bg-success">Yes</span>
                                } else {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(item.GenderSpecific) ? "Any" : item.GenderSpecific)</td>
                            <td>
                                @if (item.IsActive) {
                                    <span class="badge bg-primary">Active</span>
                                } else {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", new { id=item.LeaveTypeId })" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                                <a href="@Url.Action("Delete", new { id=item.LeaveTypeId })" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
