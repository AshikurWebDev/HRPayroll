@model HR_PayRoll_Management.ViewModels.EmployeeDeleteViewModel

@{
    ViewBag.Title = "Delete Employee";
}

@section styles {
    <link href="~/Content/Employee.css" rel="stylesheet" />
}

<div class="page-header">
    <div>
        <h1>Delete Employee</h1>
        <p>Confirm employee removal from the system.</p>
    </div>

    <a href="@Url.Action("Index","Employees")" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Back
    </a>
</div>


<div class="card delete-card">

    <div class="delete-header">
        <div class="delete-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <div>
            <h4>Are you sure?</h4>
            <p>
                This action will permanently delete this employee record.
            </p>
        </div>
    </div>


    <div class="card-body">

        <div class="employee-delete-info">

            <div>
                <label>Name</label>
                <span>@Model.FullName</span>
            </div>


            <div>
                <label>Email</label>
                <span>@Model.EmailAddress</span>
            </div>

        </div>


        @using (Html.BeginForm("Delete", "Employees", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(x => x.EmployeeId)


            <div class="delete-actions">

                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash me-2"></i>
                    Delete Employee
                </button>


                <a href="@Url.Action("Index","Employees")"
                   class="btn btn-light border">
                    Cancel
                </a>

            </div>
        }

    </div>

</div>