@model IEnumerable<HR_PayRoll_Management.ViewModels.EmployeeViewModel>

@{
    ViewBag.Title = "Employees";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Employee Management</h1>
        <p class="text-muted mb-0">
            Manage employee profiles, designations, departments and shifts.
        </p>
    </div>

    <a href="@Url.Action("Create", "Employees")" class="btn btn-primary">
        <i class="fa-solid fa-user-plus me-2"></i> Add Employee
    </a>
</div>

<div class="card employee-list-card shadow-sm">
    <div class="card-header employee-toolbar d-flex justify-content-between align-items-center bg-white py-3">
        <div class="employee-search position-relative w-50">
            <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <input type="text"
                   id="employeeSearch"
                   class="form-control ps-5"
                   placeholder="Search employee by name, email, department..." />
        </div>

        <div class="employee-count text-muted fw-semibold">
            <i class="fa-solid fa-users me-2"></i>
            <span>@Model.Count() Employees</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table employee-table align-middle table-hover mb-0" id="employeeTable">
            <thead class="table-light">
                <tr>
                    <th>Employee</th>
                    <th>Designation</th>
                    <th>Department</th>
                    <th>Shift</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="employee-profile-cell d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.PhotoPath))
                                {
                                    <img src="@Url.Content(item.PhotoPath)"
                                         class="employee-avatar rounded-circle me-3"
                                         style="width: 42px; height: 42px; object-fit: cover;"
                                         alt="@item.FullName" />
                                }
                                else
                                {
                                    <div class="employee-avatar employee-avatar-fallback rounded-circle d-flex align-items-center justify-content-center bg-light text-secondary me-3"
                                         style="width: 42px; height: 42px;">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                }

                                <div class="employee-identity">
                                    <span class="employee-name fw-bold d-block text-dark">
                                        @item.FullName
                                    </span>
                                    <span class="employee-email text-muted small">
                                        @item.EmailAddress
                                    </span>
                                </div>
                            </div>
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-briefcase me-1 text-primary"></i>
                                @item.DesignationName
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-building me-1 text-info"></i>
                                @item.DepartmentName
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-clock me-1 text-warning"></i>
                                @item.ShiftName
                            </span>
                        </td>

                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <div class="employee-actions">
                                <a href="@Url.Action("Details","Employees",new { id=item.EmployeeId })"
                                   class="action-icon view-action"
                                   title="View">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                                <a href="@Url.Action("Edit","Employees",new { id=item.EmployeeId })"
                                   class="action-icon edit-action"
                                   title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <button type="button"
                                        class="action-icon delete-action border-0 bg-transparent"
                                        title="Delete"
                                        data-emp-id="@item.EmployeeId"
                                        data-emp-name="@item.FullName">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state text-center py-5">
            <div class="empty-state-icon fs-1 text-muted mb-3">
                <i class="fa-solid fa-users"></i>
            </div>
            <h5>No Employees Found</h5>
            <p class="text-muted">Add employees to manage your workforce.</p>
            <a href="@Url.Action("Create", "Employees")" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i> Add Employee
            </a>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #dc3545;">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fa-solid fa-trash-can text-danger mb-3" style="font-size: 3rem;"></i>
                <h5>Are you sure you want to delete this employee?</h5>
                <p class="text-muted mb-0">Employee: <strong id="deleteEmployeeName"></strong></p>
                <p class="text-danger small mt-2">This action cannot be undone.</p>
            </div>
            <div class="modal-footer justify-content-center bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                @using (Html.BeginForm("Delete", "Employees", FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteEmployeeId" name="id" value="" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fa-solid fa-trash me-1"></i> Yes, Delete
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Search filter
            $("#employeeSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#employeeTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            // Delete button click — open modal
            $(".delete-action").on("click", function () {
                var empId = $(this).data("emp-id");
                var empName = $(this).data("emp-name");
                $("#deleteEmployeeId").val(empId);
                $("#deleteEmployeeName").text(empName);
                var deleteModal = new bootstrap.Modal(document.getElementById("deleteModal"));
                deleteModal.show();
            });
        });
    </script>
}
