@model HR_PayRoll_Management.ViewModels.AttendanceVM.EmployeeAttendanceHistoryVM


<div class="row mb-4">


    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h6>
                    Total Days
                </h6>

                <h3>
                    @Model.TotalDays
                </h3>

            </div>

        </div>

    </div>



    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h6>
                    Present
                </h6>

                <h3>
                    @Model.PresentDays
                </h3>

            </div>

        </div>

    </div>



    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h6>
                    Absent
                </h6>

                <h3>
                    @Model.AbsentDays
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h6>
                    Late Days
                </h6>

                <h3>
                    @Model.LateDays
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h6>
                    Leave Days
                </h6>

                <h3>
                    @Model.LeaveDays
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h6>
                    Average Hours
                </h6>

                <h3>
                    @Model.AverageWorkingHours.ToString("0.00")
                </h3>

            </div>

        </div>

    </div>
    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h6>
                    Attendance %
                </h6>

                <h3>
                    @Math.Round(Model.AttendancePercentage)%
                </h3>

            </div>

        </div>

    </div>

</div>




<div class="table-responsive">


    <table class="table table-bordered table-hover">


        <thead>

            <tr>

                <th>
                    Date
                </th>


                <th>
                    Status
                </th>


                <th>
                    Entry
                </th>


                <th>
                    Exit
                </th>


                <th>
                    Late
                </th>


                <th>
                    Working Hours
                </th>


                <th>
                    Remarks
                </th>


            </tr>


        </thead>


        <tbody>


            @if (Model.AttendanceRecords != null &&
                Model.AttendanceRecords.Any())
            {

                foreach (var item in Model.AttendanceRecords)
                {

                    <tr>

                        <td>
                            @item.AttendanceDate.ToString("dd MMM yyyy")
                        </td>


                        <td>
                            @item.Status
                        </td>


                        <td>
                            @(item.EntryTime.HasValue
                        ? item.EntryTime.Value.ToString()
                        : "-")
                        </td>


                        <td>
                            @(item.ExitTime.HasValue
                        ? item.ExitTime.Value.ToString()
                        : "-")
                        </td>


                        <td>
                            @(item.IsLate ? "Yes" : "No")
                        </td>


                        <td>
                            @(item.WorkingHour.HasValue
                        ? item.WorkingHour.Value.ToString("0.00")
                        : "-")
                        </td>


                        <td>
                            @item.Remarks
                        </td>


                    </tr>

                }

            }
            else
            {

                <tr>

                    <td colspan="7"
                        class="text-center">

                        No attendance records found.

                    </td>

                </tr>

            }


        </tbody>


    </table>


</div>