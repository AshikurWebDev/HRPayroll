@model HR_PayRoll_Management.Helpers.SystemSettings
@{
    ViewBag.Title = "System Settings";
}

<div class="page-header mb-4">
    <h1><i class="fa-solid fa-gear me-2"></i>System Settings</h1>
    <p class="text-muted">Customize your company branding across the application.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4">
                <h5 class="fw-bold mb-0">Company Branding</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Index", "Settings", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Company Name</label>
                        <input type="text" name="CompanyName" class="form-control" value="@Model.CompanyName" required placeholder="e.g. Acme Corporation" />
                        <div class="form-text">This name appears in the sidebar and browser tab titles.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Company Logo</label>

                        <!-- Current Logo Preview -->
                        <div class="mb-3 p-3 bg-light rounded d-flex align-items-center gap-3">
                            <img src="@Url.Content(Model.LogoPath)" alt="Current Logo"
                                 id="logoPreview"
                                 style="max-height: 60px; max-width: 120px; object-fit: contain; border-radius: 6px;"
                                 onerror="this.src='https://placehold.co/100x100?text=No+Logo'" />
                            <div>
                                <p class="mb-0 fw-semibold text-muted small">Current Logo</p>
                                <p class="mb-0 text-muted" style="font-size:0.78rem;">@Model.LogoPath</p>
                            </div>
                        </div>

                        <input type="file" name="logoFile" class="form-control" accept="image/*" id="logoFileInput" onchange="previewLogo(this)" />

                        <!-- Resolution Guide -->
                        <div class="alert alert-info mt-2 py-2 px-3" role="alert" style="font-size:0.82rem;">
                            <i class="fa-solid fa-circle-info me-2"></i>
                            <strong>Upload Guide:</strong>
                            <ul class="mb-0 mt-1 ps-3">
                                <li>Recommended size: <strong>100×100 px</strong> (square) or <strong>200×50 px</strong> (wide)</li>
                                <li>Accepted formats: <strong>PNG, JPG, SVG, WebP</strong></li>
                                <li>Max file size: <strong>2 MB</strong></li>
                                <li>Transparent background (PNG) works best on the dark sidebar</li>
                            </ul>
                        </div>

                        <!-- Live preview after selection -->
                        <div id="newLogoPreviewBox" class="mt-2" style="display:none;">
                            <p class="text-muted small mb-1">New logo preview:</p>
                            <img id="newLogoPreview" src="#" alt="New Logo Preview"
                                 style="max-height:60px; max-width:120px; object-fit:contain; border-radius:6px; border:1px dashed #ccc; padding:4px;" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Save Settings
                        </button>
                        <a href="@Url.Action("Index","Dashboard")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4">
                <h5 class="fw-bold mb-0">Access Control</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">This page is only accessible by <strong>Administrators</strong>. Changes here affect the entire system immediately for all users.</p>
                <hr />
                <h6 class="fw-bold text-muted small text-uppercase">Role Permissions Summary</h6>
                <ul class="list-unstyled small mt-2">
                    <li><span class="badge bg-danger me-2">Admin</span>Full access — All modules, Settings, Payroll Delete, Audit Logs</li>
                    <li class="mt-2"><span class="badge bg-primary me-2">HR Manager</span>Employees, Leave, Payroll, Reports, Audit Logs</li>
                    <li class="mt-2"><span class="badge bg-info me-2">HR Officer</span>Employees, Leave, Payroll, Reports</li>
                    <li class="mt-2"><span class="badge bg-warning text-dark me-2">Manager</span>View & approve own team's leaves</li>
                    <li class="mt-2"><span class="badge bg-success me-2">Employee</span>Own profile, payslips, leave applications only</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    function previewLogo(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('newLogoPreview').src = e.target.result;
                document.getElementById('newLogoPreviewBox').style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
