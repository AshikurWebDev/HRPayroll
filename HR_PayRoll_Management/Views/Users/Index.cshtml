@model IEnumerable<HR_PayRoll_Management.Models.User>

@{
    ViewBag.Title = "Manage Users";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Users</h1>
    <a href="@Url.Action("Create", "Users")" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Add New User
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" id="searchUserInput" class="form-control" placeholder="Search by username..." />
                    <button class="btn btn-outline-secondary" type="button" id="searchUserBtn">
                        <i class="fa-solid fa-search"></i> Search
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="usersTable">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Employee Mapping</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    @Html.Partial("_UsersTablePartial", Model)
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model != null) {
    foreach (var item in Model) {
        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteUserModal-@item.UserId" tabindex="-1" aria-labelledby="deleteUserModalLabel-@item.UserId" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteUserModalLabel-@item.UserId">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete the user <strong>@item.Username</strong>?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        @using (Html.BeginForm("Delete", "Users", new { id = item.UserId }, FormMethod.Post)) {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Yes, Delete</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@section scripts {
    <script>
        $(document).ready(function() {
            $('#searchUserBtn').click(function() {
                var query = $('#searchUserInput').val();
                $.ajax({
                    url: '@Url.Action("Search", "Users")',
                    type: 'GET',
                    data: { query: query },
                    success: function(data) {
                        $('#usersTableBody').html(data);
                    },
                    error: function() {
                        alert('Error searching users.');
                    }
                });
            });

            $('#searchUserInput').keypress(function(e) {
                if (e.which == 13) { // Enter key
                    $('#searchUserBtn').click();
                }
            });
        });
    </script>
}
