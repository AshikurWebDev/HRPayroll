@model IEnumerable<HR_PayRoll_Management.ViewModels.DepartmentVM.DepartmentViewModel>

@{
    ViewBag.Title = "Departments";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Departments</h1>
        <p class="text-muted mb-0">
            Manage organization departments and employee allocation.
        </p>
    </div>

    <a href="@Url.Action("Create", "Departments")" class="btn btn-primary">
        <i class="fa-solid fa-plus me-2"></i> Add Department
    </a>
</div>

<div class="card employee-list-card shadow-sm">
    <div class="card-header employee-toolbar d-flex justify-content-between align-items-center bg-white py-3">
        <div class="employee-search position-relative w-50">
            <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <input type="text"
                   id="departmentSearch"
                   class="form-control ps-5"
                   placeholder="Search departments..." />
        </div>

        <div class="employee-count text-muted fw-semibold">
            <i class="fa-solid fa-building me-2"></i>
            <span>@Model.Count() Departments</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table employee-table align-middle table-hover mb-0" id="departmentTable">
            <thead class="table-light">
                <tr>
                    <th>Department</th>
                    <th>Description</th>
                    <th>Employees</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="employee-profile-cell d-flex align-items-center">
                                <div class="employee-avatar employee-avatar-fallback rounded-circle d-flex align-items-center justify-content-center bg-light text-primary me-3"
                                     style="width: 40px; height: 40px;">
                                    <i class="fa-solid fa-building"></i>
                                </div>
                                <div class="employee-identity">
                                    <span class="employee-name fw-bold d-block text-dark">
                                        @item.DepartmentName
                                    </span>
                                </div>
                            </div>
                        </td>

                        <td>
                            <span class="text-muted">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-users me-1 text-primary"></i>
                                @item.EmployeeCount
                            </span>
                        </td>

                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="@Url.Action("Edit", "Departments", new { id = item.DepartmentId })"
                                   class="btn btn-outline-primary"
                                   title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger delete-action"
                                        title="Delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.DepartmentId"
                                        data-name="@item.DepartmentName"
                                        data-count="@item.EmployeeCount">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state text-center py-5">
            <div class="empty-state-icon fs-1 text-muted mb-3">
                <i class="fa-solid fa-building"></i>
            </div>
            <h5>No departments found</h5>
            <p class="text-muted">Add your first department to start managing organization structure.</p>
            <a href="@Url.Action("Create", "Departments")" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i> Add Department
            </a>
        </div>
    }
</div>

<!-- Delete & Constraint Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center" id="deleteModalLabel">
                    <span id="modalHeaderIcon" class="me-2 text-danger">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <span id="modalTitleText">Confirm Delete</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Case A: Department HAS employees (Deletion Blocked) -->
                <div id="blockedSection" class="d-none">
                    <div class="alert alert-danger border-0 d-flex align-items-start mb-3">
                        <i class="fa-solid fa-circle-xmark fs-4 me-3 mt-1 text-danger"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Cannot Delete Department</h6>
                            <p class="mb-0 small text-secondary">
                                Department <strong id="blockedDeptName" class="text-dark"></strong> cannot be removed because it has
                                <span id="assignedEmployeeCount" class="badge bg-danger rounded-pill px-2"></span> active employee(s) assigned to it.
                            </p>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                        Please reassign or remove all associated employees before attempting to delete this department.
                    </p>
                </div>

                <!-- Case B: Department has NO employees (Ready to Delete) -->
                <div id="allowedSection">
                    <p class="mb-2 text-secondary">Are you sure you want to delete this department?</p>
                    <div class="p-2 px-3 bg-light rounded border mb-2">
                        <span class="text-muted small d-block">Department Name</span>
                        <strong id="allowedDeptName" class="text-dark fs-6"></strong>
                    </div>
                    <small class="text-muted">This operation is irreversible.</small>
                </div>
            </div>

            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>

                @using (Html.BeginForm("Delete", "Departments", FormMethod.Post, new { id = "deleteForm", @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="departmentId" name="id" />

                    <button type="submit" id="confirmDeleteBtn" class="btn btn-danger">
                        <i class="fa-solid fa-trash me-2"></i> Confirm Delete
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
                $(document).ready(function () {
                    // Search filter
                    $("#departmentSearch").on("keyup", function () {
                        var value = $(this).val().toLowerCase();

                        $("#departmentTable tbody tr").filter(function () {
                            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                        });
                    });

                    // Delete Modal setup
                    $(".delete-action").click(function () {
                        var id = $(this).data("id");
                        var name = $(this).data("name");
                        var employeeCount = parseInt($(this).data("count"), 10) || 0;

                        $("#departmentId").val(id);

                        if (employeeCount > 0) {
                            // Department has employees: show blocked message, hide confirm action
                            $("#blockedSection").removeClass("d-none");
                            $("#allowedSection").addClass("d-none");

                            $("#blockedDeptName").text(name);
                            $("#assignedEmployeeCount").text(employeeCount + " employee" + (employeeCount > 1 ? "s" : ""));

                            $("#modalTitleText").text("Deletion Blocked");
                            $("#modalHeaderIcon").html('<i class="fa-solid fa-ban text-danger"></i>');
                            $("#confirmDeleteBtn").addClass("d-none"); // Hide Delete submit button completely
                        } else {
                            // Department is clean: show standard confirmation
                            $("#blockedSection").addClass("d-none");
                            $("#allowedSection").removeClass("d-none");

                            $("#allowedDeptName").text(name);

                            $("#modalTitleText").text("Confirm Delete");
                            $("#modalHeaderIcon").html('<i class="fa-solid fa-triangle-exclamation text-warning"></i>');
                            $("#confirmDeleteBtn").removeClass("d-none"); // Enable Delete submit button
                        }
                    });
                });
    </script>
}